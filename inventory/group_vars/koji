---
# Define resources for this group of hosts here.
lvm_size: 20000
mem_size: 2048
num_cpus: 1

# for systems that do not match the above - specify the same parameter in
# the host_vars/$hostname file
tcp_ports: [ 80, 443, 44334]

custom_rules: [ '-A INPUT -p tcp -m tcp --dport=44333 -i eth1 -j ACCEPT' ]

udp_ports: []

ipa_client_shell_groups:
  - sysadmin-releng
ipa_client_sudo_groups:
  - sysadmin-releng
ipa_host_group: kojihub
ipa_host_group_desc: Koji Hub hosts
primary_auth_source: ipa

fas_client_groups: sysadmin-build
sudoers: "{{ private }}/files/sudo/00releng-sudoers"

nfs_mount_opts: "rw,hard,bg,noatime,nodev,nosuid,sec=sys,nfsvers=4"
virt_install_command: "{{ virt_install_command_two_nic }}"

koji_root: "koji.rpmfusion.org/koji"
koji_hub: "koji.rpmfusion.org/kojihub"
